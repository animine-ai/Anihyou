<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Release DB is intentionally excluded; restored work must not post before account reconciliation. -->
        <exclude domain="database" path="release-data.db"/>
        <include domain="file" path="datastore/"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="release-data.db"/>
        <include domain="file" path="datastore/"/>
    </device-transfer>
</data-extraction-rules>